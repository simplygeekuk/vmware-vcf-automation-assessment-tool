<footer>
Generated by vcf-automation-assessment-tool {{ meta.tool_version }} against {{ meta.url }} at
{{ meta.generated_at | readable_date }}. Data is read-only; no changes were made to the platform.
</footer>
</div>
</div>

<script>
// CSV export for every data table, built from the DOM so it always matches
// what the report shows. Self-contained like everything else: the file is
// assembled in memory and downloaded via a Blob URL, no network involved.
// When a finding's table is capped, the truncation note is appended as a
// final row so the export says it is partial instead of pretending.
function csvField(text) {
  var value = text
    .split("\n")
    .map(function (line) { return line.trim().replace(/\s+/g, " "); })
    .filter(Boolean)
    .join("\n");
  // A leading =, +, -, @ or tab opens as a live formula when the export
  // lands in Excel (CSV injection); a leading apostrophe renders it as the
  // inert text it is. Names come from the assessed platform, so they are
  // not this report's to trust.
  if (/^[=+\-@\t]/.test(value)) value = "'" + value;
  return /[",\n]/.test(value) ? '"' + value.replace(/"/g, '""') + '"' : value;
}
function csvFromTable(table, note) {
  var lines = [];
  for (var r = 0; r < table.rows.length; r++) {
    var cells = table.rows[r].cells;
    var fields = [];
    for (var c = 0; c < cells.length; c++) fields.push(csvField(cells[c].textContent));
    lines.push(fields.join(","));
  }
  if (note) lines.push(csvField("# " + note));
  return lines.join("\r\n") + "\r\n";
}
function csvSlug(text) {
  return text
    .replace(/\(.*$/, "")
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 60);
}
function csvName(wrap) {
  var finding = wrap.closest(".finding");
  if (finding && finding.id) {
    var title = finding.querySelectorAll("strong")[1];
    return finding.id + (title ? "-" + csvSlug(title.textContent) : "");
  }
  var host = wrap.closest("details");
  var summary = host && host.querySelector(":scope > summary");
  return (summary && csvSlug(summary.textContent)) || "table";
}
document.querySelectorAll(".tablewrap").forEach(function (wrap) {
  var table = wrap.querySelector("table");
  if (!table || table.rows.length < 2) return;
  var button = document.createElement("button");
  button.type = "button";
  button.className = "csvbtn";
  button.textContent = "Export CSV";
  button.title = "Export all rendered rows, including rows hidden by search or filters";
  button.addEventListener("click", function () {
    var note = wrap.querySelector(".truncnote");
    var blob = new Blob(
      // Leading BOM so Excel detects UTF-8 instead of mangling accents.
      ["\ufeff" + csvFromTable(table, note ? note.textContent.trim() : "")],
      { type: "text/csv;charset=utf-8" }
    );
    var link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = csvName(wrap) + ".csv";
    document.body.appendChild(link);
    link.click();
    link.remove();
    setTimeout(function () { URL.revokeObjectURL(link.href); }, 1000);
  });
  wrap.parentNode.insertBefore(button, wrap);
});
</script>

<script>
// A #anchor may point inside a chapter the reader has collapsed (or into a
// closed inventory block). Open every enclosing <details> first, then scroll:
// the browser's own jump happens against hidden content otherwise.
function revealTarget(hash) {
  if (!hash || hash.length < 2) return;
  var target = document.getElementById(decodeURIComponent(hash.slice(1)));
  if (!target) return;
  var host = target.closest("details");
  while (host) {
    host.open = true;
    host = host.parentElement && host.parentElement.closest("details");
  }
  target.scrollIntoView();
}
document.addEventListener("click", function (event) {
  var link = event.target.closest && event.target.closest('a[href^="#"]');
  if (link) revealTarget(link.getAttribute("href"));
});
revealTarget(location.hash);
</script>

{% if mermaid_js %}
<script>{{ mermaid_js | safe }}</script>
<script>
mermaid.initialize({ startOnLoad: false, securityLevel: "strict", theme: "neutral" });
// Diagrams inside a collapsed <details> mis-size if rendered while hidden.
// Details also nest (the flow list sits inside a collapsible block), so a
// toggle may reveal only some of the diagrams beneath it: render exactly the
// ones whose every enclosing <details> is now open, each at most once.
var diagramWork = Promise.resolve();
function renderRevealed(scope) {
  var pending = [];
  scope.querySelectorAll("pre.mermaid").forEach(function (p) {
    if (p.dataset.rendered) return;
    var a = p.closest("details");
    while (a && a.open) a = a.parentElement && a.parentElement.closest("details");
    if (a) return; // still hidden inside a closed container
    p.dataset.rendered = "1";
    pending.push(p);
  });
  // A failed diagram keeps its raw source visible; the rejection is
  // swallowed so one bad diagram cannot spam the console per toggle.
  if (pending.length) {
    diagramWork = diagramWork.then(function () { return mermaid.run({ nodes: pending }); }).catch(function () {});
  }
  return diagramWork;
}
renderRevealed(document);
document.querySelectorAll("details").forEach(function (d) {
  if (!d.querySelector("pre.mermaid")) return;
  d.addEventListener("toggle", function () {
    if (d.open) renderRevealed(d);
  });
});
</script>
{% endif %}
