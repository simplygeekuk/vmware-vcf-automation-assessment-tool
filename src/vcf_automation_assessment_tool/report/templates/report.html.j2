{# ======================= COLLECTION GAPS ======================= #}
{% if visible.system and findings_by_section.get('system') %}
<details class="sec" id="system" open>
<summary><h2>Collection Gaps</h2></summary>
<div class="secbody">
<p class="sub">What this run could not read. Every check that stayed silent, and every claim
the report held back, comes from one of these. Fix the access and run the report
again for a complete picture.</p>
{{ section_findings('system') }}
</div>
</details>
